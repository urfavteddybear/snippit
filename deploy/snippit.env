# Snippit configuration for running the binary directly (systemd or a shell).
# With systemd this file lives at /etc/snippit/snippit.env.
# In a shell: set -a; . ./snippit.env; set +a; ./snippit
# Every value below is the default; uncomment to change it.

# Listen address. Use 127.0.0.1:8080 when a reverse proxy runs on the same host.
#SNIPPIT_ADDR=:8080

# SQLite database file. The systemd unit sets /var/lib/snippit/snippit.db.
#SNIPPIT_DB_PATH=data/snippit.db

# Public origin used in generated links (API responses, QR codes).
# Set this in production, e.g. https://paste.example.com
#SNIPPIT_BASE_URL=

# Set to true only behind a reverse proxy that overwrites X-Real-IP with the
# client IP. Otherwise clients could spoof it and bypass rate limits.
#SNIPPIT_TRUST_PROXY=false

# Maximum size of one paste, in bytes (512 KiB).
#SNIPPIT_MAX_PASTE_BYTES=524288

# Total storage quota for all pastes, in bytes (1 GiB; 0 = unlimited).
#SNIPPIT_MAX_TOTAL_BYTES=1073741824

# Paste creation rate limit per client IP.
#SNIPPIT_RATE_LIMIT_PER_MINUTE=10
#SNIPPIT_RATE_LIMIT_BURST=5

# Password and delete-key attempts per client IP.
#SNIPPIT_UNLOCK_LIMIT_PER_MINUTE=10
#SNIPPIT_UNLOCK_LIMIT_BURST=5

# Lookups of nonexistent pastes per client IP (slows down link guessing).
#SNIPPIT_NOTFOUND_LIMIT_PER_MINUTE=30
#SNIPPIT_NOTFOUND_LIMIT_BURST=30

# How often expired pastes are deleted.
#SNIPPIT_CLEANUP_INTERVAL=10m

# Requests handled at once before queueing, and the per-request timeout.
#SNIPPIT_MAX_CONCURRENT=100
#SNIPPIT_REQUEST_TIMEOUT=15s

# Optional link shown in the navbar.
#SNIPPIT_GITHUB_URL=
