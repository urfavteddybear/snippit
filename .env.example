# Copy to .env and adjust. Read by docker compose.
# Running the binary without Docker? Use deploy/snippit.env instead.

# Host port the app is published on.
SNIPPIT_PORT=8080

# Set to true only when Snippit runs behind a reverse proxy that overwrites
# the X-Real-IP header with the client IP. Otherwise clients could spoof it
# and bypass rate limits.
SNIPPIT_TRUST_PROXY=false

# Public origin used in generated links (API responses, QR codes).
# Set this in production, e.g. https://paste.example.com
SNIPPIT_BASE_URL=

# Maximum size of one paste, in bytes (default 512 KiB).
SNIPPIT_MAX_PASTE_BYTES=524288

# Total storage quota for all pastes, in bytes (default 1 GiB; 0 = unlimited).
SNIPPIT_MAX_TOTAL_BYTES=1073741824

# Paste creation rate limit per client IP.
SNIPPIT_RATE_LIMIT_PER_MINUTE=10
SNIPPIT_RATE_LIMIT_BURST=5

# How often expired pastes are deleted.
SNIPPIT_CLEANUP_INTERVAL=10m

# Optional link shown in the navbar.
SNIPPIT_GITHUB_URL=
